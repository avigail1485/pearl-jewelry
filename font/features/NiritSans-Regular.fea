languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem hebr dflt;

markClass [sheva hatafsegol hatafpatah hatafqamats hiriq tsere segol patah qamats qubuts qamatsqatan meteg] <anchor 0 0> @M_below;
markClass [dagesh] <anchor 0 0> @M_center;
markClass [holam holamhaserforvav rafe] <anchor 0 600> @M_topleft;
markClass [shindot] <anchor 0 600> @M_shin;
markClass [sindot] <anchor 0 600> @M_sin;

